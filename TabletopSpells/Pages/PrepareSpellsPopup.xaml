<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="TabletopSpells.Pages.PrepareSpellsPopup"
    Size="400,600">

    <VerticalStackLayout Padding="15" Spacing="10">
        <Label Text="Prepare Spells" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
        <ScrollView>
            <VerticalStackLayout x:Name="SpellsList" Spacing="10" />
        </ScrollView>
        <Button Text="Save Selection" Clicked="OnSaveClicked" />
    </VerticalStackLayout>
</toolkit:Popup>
