<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:TabletopSpells.Helpers"
             x:Class="TabletopSpells.Pages.ThemeColorPickerPage"
             Title="Pick Color">

    <VerticalStackLayout Padding="20" Spacing="16" BackgroundColor="{helpers:ThemeColor PageBackground}">
        <Label Text="Choose a color"
               FontAttributes="Bold"
               FontSize="20"
               TextColor="{helpers:ThemeColor TextPrimary}" />

        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="16" RowSpacing="16">
            <Frame Grid.Row="0" Grid.Column="0" BorderColor="{helpers:ThemeColor Border}"
                   BackgroundColor="{helpers:ThemeColor PageBackground}" Padding="8" CornerRadius="12">
                <GraphicsView x:Name="ColorWheelView"
                              HeightRequest="220"
                              WidthRequest="220"
                              StartInteraction="OnColorWheelStart"
                              DragInteraction="OnColorWheelDrag" />
            </Frame>

            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="12">
                <BoxView Color="{Binding PreviewColor}" HeightRequest="80" WidthRequest="80" CornerRadius="12" />
                <Label Text="Preview"
                       TextColor="{helpers:ThemeColor TextPrimary}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="12">
                <Button Text="Cancel"
                        BackgroundColor="{helpers:ThemeColor ButtonDisabled}"
                        TextColor="{helpers:ThemeColor ButtonText}"
                        Clicked="OnCancelClicked" />
                <Button Text="Apply"
                        BackgroundColor="{helpers:ThemeColor Primary}"
                        TextColor="{helpers:ThemeColor ButtonText}"
                        Clicked="OnApplyClicked" />
            </HorizontalStackLayout>
        </Grid>
    </VerticalStackLayout>
</ContentPage>