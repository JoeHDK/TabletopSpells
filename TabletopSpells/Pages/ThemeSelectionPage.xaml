<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:TabletopSpells.Helpers"
             xmlns:vm="clr-namespace:TabletopSpells.ViewModels"
             x:Class="TabletopSpells.Pages.ThemeSelectionPage"
             Title="Theme Settings">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <Label Text="Theme Settings"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{helpers:ThemeColor TextPrimary}"
                   HorizontalOptions="Center"
                   Margin="0,0,0,10"/>

            <Label Text="Select a theme for the entire application"
                   FontSize="16"
                   TextColor="{helpers:ThemeColor TextSecondary}"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20"/>

            <CollectionView ItemsSource="{Binding Themes}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ThemeOptionViewModel">
                        <Frame BorderColor="{helpers:ThemeColor Border}"
                               BackgroundColor="{helpers:ThemeColor CardBackground}"
                               Padding="15"
                               CornerRadius="10"
                               Margin="0,0,0,16">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="{Binding Title}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{helpers:ThemeColor TextPrimary}"/>

                                <Label Text="{Binding Description}"
                                       FontSize="14"
                                       TextColor="{helpers:ThemeColor TextSecondary}"/>

                                <Grid ColumnDefinitions="*,*,*,*,*,*"
                                      RowDefinitions="40,40"
                                      ColumnSpacing="10"
                                      RowSpacing="10"
                                      Margin="0,10,0,0">
                                    <BoxView Grid.Row="0" Grid.Column="0" Color="{Binding PageBackground}" CornerRadius="5"/>
                                    <BoxView Grid.Row="0" Grid.Column="1" Color="{Binding Primary}" CornerRadius="5">
                                        <BoxView.GestureRecognizers>
                                            <TapGestureRecognizer CommandParameter="Primary" Tapped="OnCustomSwatchTapped"/>
                                        </BoxView.GestureRecognizers>
                                    </BoxView>
                                    <BoxView Grid.Row="0" Grid.Column="2" Color="{Binding SpellPrepared}" CornerRadius="5">
                                        <BoxView.GestureRecognizers>
                                            <TapGestureRecognizer CommandParameter="SpellPrepared" Tapped="OnCustomSwatchTapped"/>
                                        </BoxView.GestureRecognizers>
                                    </BoxView>
                                    <BoxView Grid.Row="0" Grid.Column="3" Color="{Binding SpellDomain}" CornerRadius="5">
                                        <BoxView.GestureRecognizers>
                                            <TapGestureRecognizer CommandParameter="SpellDomain" Tapped="OnCustomSwatchTapped"/>
                                        </BoxView.GestureRecognizers>
                                    </BoxView>
                                    <BoxView Grid.Row="0" Grid.Column="4" Color="{Binding SpellNonNative}" CornerRadius="5">
                                        <BoxView.GestureRecognizers>
                                            <TapGestureRecognizer CommandParameter="SpellNonNative" Tapped="OnCustomSwatchTapped"/>
                                        </BoxView.GestureRecognizers>
                                    </BoxView>
                                    <BoxView Grid.Row="0" Grid.Column="5" Color="{Binding TextPrimary}" CornerRadius="5"/>

                                    <Label Grid.Row="1" Grid.Column="0" Text="BG" HorizontalOptions="Center" TextColor="{helpers:ThemeColor TextPrimary}" FontSize="10"/>
                                    <Label Grid.Row="1" Grid.Column="1" Text="Primary" HorizontalOptions="Center" TextColor="{helpers:ThemeColor TextPrimary}" FontSize="10"/>
                                    <Label Grid.Row="1" Grid.Column="2" Text="Prepared" HorizontalOptions="Center" TextColor="{helpers:ThemeColor TextPrimary}" FontSize="10"/>
                                    <Label Grid.Row="1" Grid.Column="3" Text="Domain" HorizontalOptions="Center" TextColor="{helpers:ThemeColor TextPrimary}" FontSize="10"/>
                                    <Label Grid.Row="1" Grid.Column="4" Text="Non-Native" HorizontalOptions="Center" TextColor="{helpers:ThemeColor TextPrimary}" FontSize="10"/>
                                    <Label Grid.Row="1" Grid.Column="5" Text="Text" HorizontalOptions="Center" TextColor="{helpers:ThemeColor TextPrimary}" FontSize="10"/>
                                </Grid>

                                <Button Text="Select Theme"
                                        BackgroundColor="{helpers:ThemeColor ButtonBackground}"
                                        TextColor="{helpers:ThemeColor ButtonText}"
                                        Clicked="OnSelectThemeClicked"
                                        CommandParameter="{Binding}"/>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
