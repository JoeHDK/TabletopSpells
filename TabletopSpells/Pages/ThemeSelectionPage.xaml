<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:TabletopSpells.Helpers"
             x:Class="TabletopSpells.Pages.ThemeSelectionPage"
             Title="Theme Selection">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            
            <!-- Header -->
            <Label Text="Choose Your Theme"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{helpers:ThemeColor TextPrimary}"
                   HorizontalOptions="Center"
                   Margin="0,0,0,10"/>

            <Label Text="Select a theme for the entire application"
                   FontSize="16"
                   TextColor="{helpers:ThemeColor TextSecondary}"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20"/>

            <!-- Dark Theme Preview -->
            <Frame BorderColor="{helpers:ThemeColor Border}"
                   BackgroundColor="{helpers:ThemeColor CardBackground}"
                   Padding="15"
                   CornerRadius="10">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Dark Theme"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{helpers:ThemeColor TextPrimary}"/>
                    
                    <Label Text="Optimized for low-light environments with high contrast"
                           FontSize="14"
                           TextColor="{helpers:ThemeColor TextSecondary}"/>

                    <!-- Color Samples -->
                    <Grid ColumnDefinitions="*,*,*,*" 
                          RowDefinitions="40,40"
                          ColumnSpacing="10"
                          RowSpacing="10"
                          Margin="0,10,0,0">
                        <BoxView Grid.Row="0" Grid.Column="0" BackgroundColor="#000000" CornerRadius="5"/>
                        <BoxView Grid.Row="0" Grid.Column="1" BackgroundColor="#512BD4" CornerRadius="5"/>
                        <BoxView Grid.Row="0" Grid.Column="2" BackgroundColor="#90EE90" CornerRadius="5"/>
                        <BoxView Grid.Row="0" Grid.Column="3" BackgroundColor="#FFFFFF" CornerRadius="5"/>
                        <Label Grid.Row="1" Grid.Column="0" Text="BG" HorizontalOptions="Center" TextColor="{helpers:ThemeColor TextPrimary}" FontSize="10"/>
                        <Label Grid.Row="1" Grid.Column="1" Text="Primary" HorizontalOptions="Center" TextColor="{helpers:ThemeColor TextPrimary}" FontSize="10"/>
                        <Label Grid.Row="1" Grid.Column="2" Text="Prepared" HorizontalOptions="Center" TextColor="{helpers:ThemeColor TextPrimary}" FontSize="10"/>
                        <Label Grid.Row="1" Grid.Column="3" Text="Text" HorizontalOptions="Center" TextColor="{helpers:ThemeColor TextPrimary}" FontSize="10"/>
                    </Grid>

                    <Button x:Name="DarkThemeButton"
                            Text="Select Dark Theme"
                            BackgroundColor="{helpers:ThemeColor ButtonBackground}"
                            TextColor="{helpers:ThemeColor ButtonText}"
                            Clicked="OnDarkThemeClicked"
                            Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Light Theme Preview -->
            <Frame BorderColor="{helpers:ThemeColor Border}"
                   BackgroundColor="{helpers:ThemeColor CardBackground}"
                   Padding="15"
                   CornerRadius="10">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Light Theme"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{helpers:ThemeColor TextPrimary}"/>
                    
                    <Label Text="Optimized for bright environments with comfortable contrast"
                           FontSize="14"
                           TextColor="{helpers:ThemeColor TextSecondary}"/>

                    <!-- Color Samples -->
                    <Grid ColumnDefinitions="*,*,*,*" 
                          RowDefinitions="40,40"
                          ColumnSpacing="10"
                          RowSpacing="10"
                          Margin="0,10,0,0">
                        <BoxView Grid.Row="0" Grid.Column="0" BackgroundColor="#FFFFFF" CornerRadius="5"/>
                        <BoxView Grid.Row="0" Grid.Column="1" BackgroundColor="#512BD4" CornerRadius="5"/>
                        <BoxView Grid.Row="0" Grid.Column="2" BackgroundColor="#228B22" CornerRadius="5"/>
                        <BoxView Grid.Row="0" Grid.Column="3" BackgroundColor="#000000" CornerRadius="5"/>
                        <Label Grid.Row="1" Grid.Column="0" Text="BG" HorizontalOptions="Center" TextColor="{helpers:ThemeColor TextPrimary}" FontSize="10"/>
                        <Label Grid.Row="1" Grid.Column="1" Text="Primary" HorizontalOptions="Center" TextColor="{helpers:ThemeColor TextPrimary}" FontSize="10"/>
                        <Label Grid.Row="1" Grid.Column="2" Text="Prepared" HorizontalOptions="Center" TextColor="{helpers:ThemeColor TextPrimary}" FontSize="10"/>
                        <Label Grid.Row="1" Grid.Column="3" Text="Text" HorizontalOptions="Center" TextColor="{helpers:ThemeColor TextPrimary}" FontSize="10"/>
                    </Grid>

                    <Button x:Name="LightThemeButton"
                            Text="Select Light Theme"
                            BackgroundColor="{helpers:ThemeColor ButtonBackground}"
                            TextColor="{helpers:ThemeColor ButtonText}"
                            Clicked="OnLightThemeClicked"
                            Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

