<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:TabletopSpells.Converters"
             x:Class="TabletopSpells.Pages.SpellListPage"
             Title="Spells">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:PreparedSpellColorConverter x:Key="PreparedSpellColorConverter" />
            <converters:FavoriteGlyphConverter x:Key="FavoriteGlyphConverter" />
            <converters:FavoriteColorConverter x:Key="FavoriteColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Filter Spells"
                     IconImageSource="menu.png"
                     Clicked="OnMenuClicked"
                     Priority="0"
                     Order="Primary"/>
    </ContentPage.ToolbarItems>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 🔍 Search bar -->
        <SearchBar x:Name="SpellSearchBar"
                   Grid.Row="0"
                   Placeholder="Search spells..."
                   TextChanged="OnSearchTextChanged" />

        <!-- 🧮 Prepared spell counter (divine casters only) -->
        <Label Grid.Row="1"
               Text="{Binding PreparedSpellCountText}"
               IsVisible="{Binding IsDivineCaster}"
               FontAttributes="Bold"
               FontSize="16"
               Margin="10,10,10,0" />

        <!-- Unified spell list for all casters -->
        <CollectionView x:Name="SpellCollectionView"
                        ItemsSource="{Binding FilteredSpellViewModels}"
                        SelectionMode="Single"
                        SelectionChanged="OnSpellSelected"
                        Grid.Row="2">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10" ColumnDefinitions="*,Auto" RowSpacing="5">
                        <StackLayout Grid.Column="0">
                            <Label FontAttributes="Bold"
                                   FontSize="16"
                                   Text="{Binding Spell.Name}" />
                            <Label Text="{Binding Spell.SpellLevel}"
                                   FontSize="12"
                                   TextColor="Gray" />
                        </StackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
