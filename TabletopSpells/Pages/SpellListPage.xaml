<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:TabletopSpells.Converters"
             x:Class="TabletopSpells.Pages.SpellListPage"
             Title="Spells">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:PreparedSpellColorConverter x:Key="PreparedSpellColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Filter Spells"
                     IconImageSource="menu.png"
                     Clicked="OnMenuClicked"
                     Priority="0"
                     Order="Primary"/>
    </ContentPage.ToolbarItems>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 🔍 Search bar -->
        <SearchBar x:Name="SpellSearchBar"
                   Grid.Row="0"
                   Placeholder="Search spells..."
                   TextChanged="OnSearchTextChanged" />

        <!-- 🧮 Prepared spell counter -->
        <Label Grid.Row="1"
               Text="{Binding PreparedSpellCountText}"
               IsVisible="{Binding IsDivineCaster}"
               FontAttributes="Bold"
               FontSize="16"
               Margin="10,10,10,0" />

        <!-- 🛐 Divine caster spell list -->
        <CollectionView Grid.Row="2"
                        IsVisible="{Binding IsDivineCaster}"
                        ItemsSource="{Binding SpellViewModels}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10" ColumnDefinitions="*,Auto">
                        <StackLayout>
                            <Label FontAttributes="Bold"
                                   FontSize="16"
                                   Text="{Binding Spell.Name}">
                                <Label.TextColor>
                                    <Binding Path="IsPrepared"
                                             Converter="{StaticResource PreparedSpellColorConverter}" />
                                </Label.TextColor>
                            </Label>
                            <Label Text="{Binding Spell.SpellLevel}"
                                   FontSize="12"
                                   TextColor="Gray" />
                        </StackLayout>

                        <CheckBox IsChecked="{Binding IsPrepared, Mode=TwoWay}"
                                  Grid.Column="1"
                                  VerticalOptions="Center"
                                  HorizontalOptions="End"
                                  HeightRequest="30"
                                  WidthRequest="30" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- 🧙 Non-divine caster spell list -->
        <CollectionView x:Name="SpellCollectionView"
                        IsVisible="{Binding IsDivineCaster, Converter={StaticResource InverseBoolConverter}}"
                        ItemsSource="{Binding FilteredSpells}"
                        SelectionMode="Single"
                        SelectionChanged="OnSpellSelected"
                        Grid.Row="2">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout Padding="10">
                        <Label Text="{Binding Name}"
                               FontAttributes="Bold"
                               FontSize="16" />
                        <Label Text="{Binding SpellLevel}"
                               FontSize="12"
                               TextColor="Gray" />
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
