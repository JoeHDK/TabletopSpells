<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TabletopSpells.Pages.PrepareSpellReplacementDialog"
             Title="Replace Prepared Spell"
             BackgroundColor="#2b2b2b">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20" RowSpacing="10">
        <!-- Header -->
        <Label Grid.Row="0"
               Text="You have reached the maximum number of prepared spells."
               FontSize="16"
               FontAttributes="Bold"
               TextColor="White"
               LineBreakMode="WordWrap" />

        <Label Grid.Row="0"
               Text="{Binding SelectedSpellName, StringFormat='Select a spell to replace it with {0}'}"
               FontSize="14"
               TextColor="LightGray"
               Margin="0,40,0,0"
               LineBreakMode="WordWrap" />

        <!-- List of prepared spells to replace -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding PreparedSpells}"
                        SelectionMode="Single"
                        SelectionChanged="OnSpellSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout Padding="10" Spacing="5">
                        <Label Text="{Binding Name}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="White" />
                        <Label Text="{Binding SpellLevel}"
                               FontSize="12"
                               TextColor="Gray" />
                        <BoxView Color="Gray" HeightRequest="1" />
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button Grid.Column="0"
                    Text="Cancel"
                    Clicked="OnCancelClicked"
                    BackgroundColor="#555555"
                    TextColor="White" />
            <Button Grid.Column="1"
                    Text="Replace"
                    Clicked="OnReplaceClicked"
                    BackgroundColor="#2196F3"
                    TextColor="White"
                    IsEnabled="{Binding IsSelectionValid}" />
        </Grid>
    </Grid>
</ContentPage>

