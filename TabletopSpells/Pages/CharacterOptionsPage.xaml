<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:TabletopSpells.Helpers"
             x:Class="TabletopSpells.Pages.CharacterOptionsPage"
             Title="Character Options">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            
            <!-- Header -->
            <Label Text="Character Options"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{helpers:ThemeColor TextPrimary}"
                   HorizontalOptions="Center"
                   Margin="0,0,0,10"/>

            <!-- Theme Section -->
            <Frame BorderColor="{helpers:ThemeColor Border}"
                   BackgroundColor="{helpers:ThemeColor CardBackground}"
                   Padding="15"
                   CornerRadius="10">
                <VerticalStackLayout Spacing="10">
                    <Label Text="🎨 Theme Settings"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{helpers:ThemeColor TextPrimary}"/>
                    
                    <Label Text="Switch between dark and light modes"
                           FontSize="14"
                           TextColor="{helpers:ThemeColor TextSecondary}"/>

                    <Button x:Name="ThemeToggleButton"
                            Text="Toggle Theme"
                            BackgroundColor="{helpers:ThemeColor ButtonBackground}"
                            TextColor="{helpers:ThemeColor ButtonText}"
                            Clicked="OnToggleThemeClicked"
                            Margin="0,10,0,0"/>

                    <Button Text="Advanced Theme Settings"
                            BackgroundColor="{helpers:ThemeColor Primary}"
                            TextColor="{helpers:ThemeColor ButtonText}"
                            Clicked="OnViewAppThemeSettingsClicked"
                            Margin="0,5,0,0"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Danger Zone -->
            <Frame BorderColor="{helpers:ThemeColor Error}"
                   BackgroundColor="{helpers:ThemeColor CardBackground}"
                   Padding="15"
                   CornerRadius="10"
                   Margin="0,20,0,0">
                <VerticalStackLayout Spacing="10">
                    <Button Text="Delete Character"
                            BackgroundColor="{helpers:ThemeColor Error}"
                            TextColor="{helpers:ThemeColor ButtonText}"
                            Clicked="OnDeleteCharacterClicked"
                            Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

