<!-- SpellsPerDayPage.xaml -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TabletopSpells.ViewModels"
             xmlns:helpers="clr-namespace:TabletopSpells.Helpers"
             x:Class="TabletopSpells.Pages.SpellsPerDayPage"
             Title="Spells per day">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Reset"
                     Clicked="OnResetSpellsPerDayClicked"
                     Priority="0" 
                     Order="Primary"/>
    </ContentPage.ToolbarItems>

    <StackLayout>
        <ListView x:Name="lvSpellsPerDay" 
                  ItemsSource="{Binding SpellLevels}"
                  ItemSelected="OnSpellLevelSelected"
                  HasUnevenRows="True"
                  VerticalScrollBarVisibility="Never">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:SpellLevelViewModel">
                    <ViewCell>
                        <StackLayout Orientation="Vertical">
                            <Label Text="{Binding DisplayText}" 
                                   FontAttributes="Bold"
                                   TextColor="{helpers:ThemeColor TextPrimary}"
                                   Margin="0,10,0,0"
                                   HorizontalTextAlignment="Center"/>
                            <Frame BorderColor="{helpers:ThemeColor Border}"
                                   Padding="1"
                                   HorizontalOptions="FillAndExpand"
                                   VerticalOptions="Center"
                                   BackgroundColor="{helpers:ThemeColor Transparent}"
                                   HeightRequest="30">
                                <!-- Frame as the border provider -->
                                <Grid Padding="0">
                                    <!-- Grid to hold the ProgressBar and Label -->
                                    <ProgressBar Progress="{Binding ProgressValue}"
                                                 ProgressColor="{helpers:ThemeColor ManaBar}"
                                                 BackgroundColor="{helpers:ThemeColor Transparent}"
                                                 HorizontalOptions="FillAndExpand"
                                                 VerticalOptions="FillAndExpand"/>
                                    <Label Text="{Binding DetailText}" 
                                           HorizontalOptions="Center" 
                                           VerticalOptions="Center"
                                           TextColor="{helpers:ThemeColor TextPrimary}"/>
                                </Grid>
                            </Frame>
                        </StackLayout>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackLayout>
</ContentPage>
