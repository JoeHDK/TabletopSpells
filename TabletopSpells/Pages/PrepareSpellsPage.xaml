<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TabletopSpells.Pages"
             xmlns:helpers="clr-namespace:TabletopSpells.Helpers"
             x:Class="TabletopSpells.Pages.PrepareSpellsPage"
             Title="Prepare Spells">
    
    <Grid Padding="12" RowSpacing="10" RowDefinitions="Auto,Auto,*,Auto">
        
        <Label Text="Select spells to prepare" 
               FontAttributes="Bold" 
               FontSize="18"
               Grid.Row="0" />
        
        <Label Text="{Binding PrepareSummary}" 
               FontSize="14"
               Grid.Row="1" />
        
        <CollectionView ItemsSource="{Binding AddedSpells}" 
                        SelectionMode="None"
                        Grid.Row="2">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8" ColumnSpacing="12" BackgroundColor="{helpers:ThemeColor Transparent}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type local:PrepareSpellsPage}}, Path=BindingContext.TogglePreparedCommand}"
                                CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                        
                        <CheckBox IsChecked="{Binding IsPrepared}" 
                                  VerticalOptions="Center"
                                  IsEnabled="{Binding IsCheckboxEnabled}"
                                  Color="{helpers:ThemeColor SpellPrepared}" />
                        
                        <Label Grid.Column="1" 
                               Text="{Binding Name}" 
                               VerticalOptions="Center"
                               FontSize="16" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Buttons -->
        <HorizontalStackLayout HorizontalOptions="End" Spacing="8" Padding="0,10,0,0" Grid.Row="3">
            <Button Text="Cancel" 
                    Command="{Binding CancelCommand}"
                    Padding="16,8" />
            <Button Text="Save" 
                    Command="{Binding SaveCommand}"
                    Padding="16,8" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>

