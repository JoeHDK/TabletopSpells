<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:TabletopSpells.Helpers"
             x:Class="TabletopSpells.Pages.SpellLogPage"
             Title="Spell Log">

    <ContentPage.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="SpellLogHeaderTemplate">
                <ViewCell>
                    <Label Text="{Binding Key}" 
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           FontSize="Large"
                           BackgroundColor="{helpers:ThemeColor Transparent}" 
                           TextColor="{helpers:ThemeColor TextPrimary}"
                           Padding="10"/>
                </ViewCell>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ListView x:Name="lvSpellLogs"
              ItemsSource="{Binding GroupedLogs}"
              IsGroupingEnabled="True"
              GroupDisplayBinding="{Binding Key}"
              GroupHeaderTemplate="{StaticResource SpellLogHeaderTemplate}"
              VerticalOptions="FillAndExpand"
              HasUnevenRows="True">
        <ListView.ItemTemplate>
            <DataTemplate>
                <ViewCell>
                    <StackLayout Orientation="Vertical">
                        <Label Text="{Binding SpellName}" FontAttributes="Bold" TextColor="{helpers:ThemeColor TextPrimary}"/>
                        <Label TextColor="{helpers:ThemeColor TextPrimary}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Spell level: " />
                                    <Span Text="{Binding SpellLevel}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label Text="{Binding CastTime, StringFormat='{0:G}'}" TextColor="{helpers:ThemeColor TextTertiary}"/>
                        <Label Text="{Binding FailedReason}" TextColor="{helpers:ThemeColor Error}"/>
                    </StackLayout>
                </ViewCell>
            </DataTemplate>
        </ListView.ItemTemplate>

    </ListView>
</ContentPage>
