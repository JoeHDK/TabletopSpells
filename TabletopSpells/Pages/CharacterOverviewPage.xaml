<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:TabletopSpells.Helpers"
             x:Class="TabletopSpells.Pages.CharacterOverviewPage"
             Title="Character Spells">

    <Grid BackgroundColor="{helpers:ThemeColor PageBackground}" Margin="0, 10, 0, 0">
        <!-- Grid Row Definitions -->
        <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="auto"/> <!-- Added a new row -->
        </Grid.RowDefinitions>


        <Grid.ColumnDefinitions>
            <!-- Column 1 -->
            <ColumnDefinition Width="*" />
            <!-- Column 2 -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Show Spells -->
        <Button Text="Spells"
                HeightRequest="75"
                Grid.Column="0"
                Grid.Row="0"
                Clicked="OnSpellsSelected"
                BackgroundColor="{helpers:ThemeColor ButtonBackground}"
                TextColor="{helpers:ThemeColor ButtonText}"
                Margin="10, 0, 10, 0" />

        <Button Text="Spells per day"
                HeightRequest="75"
                Grid.Column="1"
                Grid.Row="0"
                Clicked="OnSpellPerDaySelected"
                BackgroundColor="{helpers:ThemeColor ButtonBackground}"
                TextColor="{helpers:ThemeColor ButtonText}"
                Margin="0, 0, 10, 0" />

        <Button Text="Spell log"
                HeightRequest="75"
                Grid.Column="1"
                Grid.Row="1"
                Clicked="OnSpellLogSelected"
                BackgroundColor="{helpers:ThemeColor ButtonBackground}"
                TextColor="{helpers:ThemeColor ButtonText}"
                Margin="0, 10, 10, 0" />
        
        <Button Text="Stats"
                HeightRequest="75"
                Grid.Column="1"
                Grid.Row="2" 
                Clicked="OnStatsPageButtonClicked"
                BackgroundColor="{helpers:ThemeColor ExperienceBar}"
                TextColor="{helpers:ThemeColor ButtonText}"
                Margin="0, 10, 10, 0">
        </Button>

        <!--Options Button-->
        <Button Text="⚙️"
                Grid.Column="1" 
                Grid.Row="4" 
                HorizontalOptions="End"
                Clicked="OnOptionsClicked" 
                BackgroundColor="{helpers:ThemeColor Transparent}"
                BorderColor="transparent"
                TextColor="{helpers:ThemeColor TextSecondary}"
                FontSize="24"
                Margin="10, 0"/>
    </Grid>
</ContentPage>
